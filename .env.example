# ─── Supabase ─────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRET — никогда не коммить. Используется только в API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Gladia (транскрипция) ────────────────────────────────────────
# Get from: https://app.gladia.io → API keys
GLADIA_API_KEY=                  # owner key (your personal account)
GLADIA_API_KEY_PUBLIC=           # optional: public users key (separate billing account)

# ─── Groq (резюме) ────────────────────────────────────────────────
# Get from: https://console.groq.com → API keys
GROQ_API_KEY=                    # owner key (your personal account)
GROQ_API_KEY_PUBLIC=             # optional: public users key (separate billing account)

# ─── API key routing ──────────────────────────────────────────────
# Supabase UUID of the owner. Owner traffic uses GLADIA_API_KEY / GROQ_API_KEY.
# All other users use the _PUBLIC variants (falls back to owner keys if not set).
OWNER_USER_ID=

# ─── App ──────────────────────────────────────────────────────────
# Локально: http://localhost:3000
# Prod: https://transcribo.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Telegram Bot ─────────────────────────────────────────────────
# Get from: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Random secret for webhook validation: openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=

# ─── MercadoPago (planned, BACKLOG M1) ────────────────────────────
# Расскоментировать при интеграции checkout.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
