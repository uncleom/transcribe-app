# ─── Supabase ─────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRET — никогда не коммить. Используется только в API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Gladia (транскрипция) ────────────────────────────────────────
# Get from: https://app.gladia.io → API keys
GLADIA_API_KEY=

# ─── Groq (резюме) ────────────────────────────────────────────────
# Get from: https://console.groq.com → API keys
GROQ_API_KEY=

# ─── App ──────────────────────────────────────────────────────────
# Локально: http://localhost:3000
# Prod: https://transcribo.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MercadoPago (planned, BACKLOG M1) ────────────────────────────
# Расскоментировать при интеграции checkout.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
